{
  "name": "nexzen-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run dev --workspace server\"",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test": "vitest --run",
    "setup:env": "node -e \"const fs=require('fs'); const files=['.env.example','client/.env.example','server/.env.example']; files.forEach(f=>{ if(!fs.existsSync(f)) console.log('missing', f); });\""
  },
  "devDependencies": {
    "autoprefixer": "^10.5.6",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@supabase/supabase-js": "^2.116.0",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.3",
    "three": "^0.186.0"
  }
}
